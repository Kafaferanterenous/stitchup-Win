#include <winver.h>

// App icon resource
101 ICON "app.ico"

// Version info. Keep these in step with kAppTitle in src/app.cpp.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     0,12,2,0
  PRODUCTVERSION  0,12,2,0
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Stitchup"
      VALUE "FileDescription",  "Stitchup PDF Editor"
      VALUE "FileVersion",      "0.12.2.0"
      VALUE "InternalName",     "Stitchup"
      VALUE "OriginalFilename", "Stitchup.exe"
      VALUE "ProductName",      "Stitchup PDF Editor"
      VALUE "ProductVersion",   "0.12.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END