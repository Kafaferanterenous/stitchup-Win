#include <winver.h>

// App icon resource. The generated .rc lives in the build tree, so the icon
// needs an absolute path rather than one relative to the source file.
101 ICON "@STITCHUP_RC_ICON@"

// Version info. The numbers are generated from the VERSION file at the repo
// root by CMakeLists.txt (see resources/app.rc.in); edit that file, not this.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     @STITCHUP_VER_MAJOR@,@STITCHUP_VER_MINOR@,@STITCHUP_VER_PATCH@,0
  PRODUCTVERSION  @STITCHUP_VER_MAJOR@,@STITCHUP_VER_MINOR@,@STITCHUP_VER_PATCH@,0
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Stitchup"
      VALUE "FileDescription",  "Stitchup PDF Editor"
      VALUE "FileVersion",      "@STITCHUP_VERSION@.0"
      VALUE "InternalName",     "Stitchup"
      VALUE "OriginalFilename", "Stitchup.exe"
      VALUE "ProductName",      "Stitchup PDF Editor"
      VALUE "ProductVersion",   "@STITCHUP_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END